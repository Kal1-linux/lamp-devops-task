# Production Terraform Remote State Configuration
#
# To enable remote state storage with state locking:
# 1. Create an AWS S3 bucket and a DynamoDB table for state locking.
# 2. Rename this file to `backend.tf` and run `terraform init`.

terraform {
  backend "s3" {
    bucket         = "my-company-terraform-state-bucket"
    key            = "lamp-stack/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "terraform-state-locks"
  }
}
